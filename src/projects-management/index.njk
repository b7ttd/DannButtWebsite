---
layout: base.njk
title: Project Management
---

<section class="page-section">
    <div class="container">
        <div class="projects-management-header">
            <h2 class="projects-title">Event & Project Management</h2>
            <p class="projects-subtitle sqsrte-large">Large-scale event coordination and production management</p>
        </div>
        
        <!-- Category Filter -->
        <div class="category-filters">
            <button class="filter-btn active" data-filter="all">All Events</button>
            <button class="filter-btn" data-filter="Walk">Walks</button>
            <button class="filter-btn" data-filter="Race">Races</button>
            <button class="filter-btn" data-filter="Parade">Parades</button>
            <button class="filter-btn" data-filter="Corporate">Corporate</button>
            <button class="filter-btn" data-filter="Theater">Theater</button>
        </div>
        
        <div class="projects-management-grid" id="projectsGrid">
            {% for project in projectManagementProjects %}
            <div class="project-management-card" data-category="{{ project.category }}">
                <a href="{{ project.link }}" class="project-card-link">
                    <div class="project-image-wrapper">
                        <img src="{{ project.image }}" alt="{{ project.title }}" loading="lazy">
                        <div class="project-category-badge">{{ project.category }}</div>
                    </div>
                    <div class="project-info">
                        <h3 class="project-title">{{ project.title }}</h3>
                        <p class="project-role">{{ project.role }}</p>
                        <p class="project-year">{{ project.year }}</p>
                    </div>
                    <div class="project-button-wrapper">
                        <span class="project-button">View Details →</span>
                    </div>
                </a>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<style>
    .projects-management-header {
        text-align: center;
        margin-bottom: 2rem;
        padding: 2rem 0 1rem;
    }

    .projects-title {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 600;
        margin-bottom: 0.5rem;
        letter-spacing: -0.02em;
        color: #ffffff;
    }

    .projects-subtitle {
        font-size: 1.2rem;
        color: #aaaaaa;
        font-weight: 400;
    }

    /* Category Filters */
    .category-filters {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin-bottom: 2.5rem;
    }

    .filter-btn {
        padding: 0.5rem 1.25rem;
        background: transparent;
        border: 1.5px solid #444444;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        color: #dddddd;
    }

    .filter-btn:hover {
        border-color: #ffffff;
        color: #ffffff;
    }

    .filter-btn.active {
        background: #ffffff;
        border-color: #ffffff;
        color: #000000;
    }

    /* Projects Grid */
    .projects-management-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2rem;
        max-width: 1400px;
        margin: 0 auto;
        padding: 1rem 0 3rem;
    }

    .project-management-card {
        background: #111111;
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    .project-management-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    }

    .project-card-link {
        text-decoration: none;
        display: block;
    }

    .project-image-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 3 / 2;
        overflow: hidden;
        background: #222222;
    }

    .project-image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.3s ease;
    }

    .project-management-card:hover .project-image-wrapper img {
        transform: scale(1.03);
    }

    .project-category-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: rgba(255,255,255,0.95);
        color: #000000;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .project-info {
        padding: 1.25rem 1.25rem 0.5rem;
    }

    .project-title {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 0.35rem;
        color: #ffffff;
    }

    .project-role {
        font-size: 0.85rem;
        color: #cccccc;
        margin-bottom: 0.25rem;
    }

    .project-year {
        font-size: 0.8rem;
        color: #888888;
    }

    .project-button-wrapper {
        padding: 0 1.25rem 1.25rem;
        text-align: left;
    }

    .project-button {
        display: inline-block;
        color: #ffffff;
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .project-management-card:hover .project-button {
        color: #0066cc;
        transform: translateX(3px);
    }

    /* Responsive */
    @media (max-width: 768px) {
        .projects-management-grid {
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
            padding: 0 1rem 2rem;
        }
        
        .category-filters {
            gap: 0.5rem;
            margin-bottom: 1.5rem;
            padding: 0 1rem;
        }
        
        .filter-btn {
            padding: 0.4rem 1rem;
            font-size: 0.75rem;
        }
        
        .project-info {
            padding: 1rem 1rem 0.25rem;
        }
        
        .project-button-wrapper {
            padding: 0 1rem 1rem;
        }
    }

    @media (max-width: 480px) {
        .projects-management-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    // Category filter functionality
    document.addEventListener('DOMContentLoaded', function() {
        const filterButtons = document.querySelectorAll('.filter-btn');
        const projectCards = document.querySelectorAll('.project-management-card');
        
        filterButtons.forEach(button => {
            button.addEventListener('click', () => {
                // Update active button
                filterButtons.forEach(btn => btn.classList.remove('active'));
                button.classList.add('active');
                
                const filterValue = button.getAttribute('data-filter');
                
                // Filter projects
                projectCards.forEach(card => {
                    if (filterValue === 'all' || card.getAttribute('data-category') === filterValue) {
                        card.style.display = 'block';
                        setTimeout(() => {
                            card.style.opacity = '1';
                            card.style.transform = 'scale(1)';
                        }, 10);
                    } else {
                        card.style.opacity = '0';
                        card.style.transform = 'scale(0.8)';
                        setTimeout(() => {
                            card.style.display = 'none';
                        }, 200);
                    }
                });
            });
        });
    });
</script>
