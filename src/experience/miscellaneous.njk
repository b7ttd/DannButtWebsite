---
layout: base.njk
title: Miscellaneous Experience
---

<section class="page-section">
    <div class="container">
        <div class="category-header">
            <h2 class="category-title">🎭 Miscellaneous</h2>
            <p class="category-subtitle">Stagehand work, assistant directing, film production, and more</p>
        </div>

        <div class="experience-category-grid">
            {% for project in allProjects %}
                {% if project.category == "Miscellaneous" %}
                <div class="category-card">
                    <a href="{{ project.link }}" class="category-card-link">
                        <div class="category-image-wrapper">
                            <img src="{{ project.image }}" alt="{{ project.title }}" loading="lazy">
                        </div>
                        <div class="category-card-info">
                            <h3 class="category-card-title">{{ project.title }}</h3>
                            <p class="category-card-role">{{ project.role }}</p>
                            <p class="category-card-year">{{ project.year }}</p>
                        </div>
                        <div class="category-card-button">
                            <span class="category-button">View Details →</span>
                        </div>
                    </a>
                </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>

<style>
    .category-header {
        text-align: center;
        margin-bottom: 2rem;
        padding: 2rem 0 1rem;
    }

    .category-title {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: #ffffff;
    }

    .category-subtitle {
        font-size: 1.2rem;
        color: #aaaaaa;
        font-weight: 400;
    }

    .experience-category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2rem;
        max-width: 1400px;
        margin: 0 auto;
        padding: 1rem 0 3rem;
    }

    .category-card {
        background: #111111;
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    .category-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    }

    .category-card-link {
        text-decoration: none;
        display: block;
    }

    .category-image-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: #222222;
    }

    .category-image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center center;
        display: block;
        transition: transform 0.3s ease;
    }

    .category-card:hover .category-image-wrapper img {
        transform: scale(1.03);
    }

    .category-card-info {
        padding: 1.25rem 1.25rem 0.5rem;
    }

    .category-card-title {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 0.35rem;
        color: #ffffff;
    }

    .category-card-role {
        font-size: 0.85rem;
        color: #cccccc;
        margin-bottom: 0.25rem;
    }

    .category-card-year {
        font-size: 0.8rem;
        color: #888888;
    }

    .category-card-button {
        padding: 0 1.25rem 1.25rem;
        text-align: left;
    }

    .category-button {
        display: inline-block;
        color: #ffffff;
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .category-card:hover .category-button {
        color: #0066cc;
        transform: translateX(3px);
    }

    @media (max-width: 768px) {
        .experience-category-grid {
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
            padding: 0 1rem 2rem;
        }
    }

    @media (max-width: 480px) {
        .experience-category-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
