<!-- FEATURE SECTION: Garden City Community Church - Production Assistant -->
<section class="page-section">
    <div class="feature-row">
        <div class="feature-text">
            <p class="sqsrte-large">Production Assistant</p>
            <p>Garden City Community Church - Garden City, NY | March 2021 – August 2023</p>
            <p style="margin-top: 1rem;">Operated professional-grade cameras, audio mixers, and microphones for weekly live-streamed services. Mixed audio for wired and wireless systems and broadcasted performances to online platforms. Became familiar with live-streaming software and how to integrate it with AV technology.</p>
        </div>
        <div class="feature-image">
            <img src="https://images.squarespace-cdn.com/content/v1/66a135183ddfaa43af16a576/a4687ce0-8326-4c8d-a194-8fa2de23a919/P1+STEEL+STRUCTURE.jpeg" alt="Church Production">
        </div>
    </div>
</section>

<!-- RECENTLY / RESUME SECTION -->
<section class="page-section">
    <div class="container">
        <hr>
        <h2 style="margin-bottom: 2rem;">Recently:</h2>
        <div class="recent-grid">
            {% for item in recent %}
            <div class="recent-item">
                <p>{{ item.year }} {{ item.location }}</p>
                <h4>{{ item.institution }}</h4>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
