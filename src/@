---
layout: base.njk
title: Home
---

<!-- PROJECT SHOWCASE VIDEO - TOP OF PAGE -->
<section class="page-section">
    <div class="container">
        <div class="video-container">
            <video class="showcase-video" autoplay muted loop playsinline>
                <source src="/images/EventageVideo.mp4" type="video/mp4">
                Your browser does not support the video tag.
            </video>
        </div>
    </div>
</section>

<!-- INTRO TEXT SECTION -->
<section class="page-section">
    <div class="two-column-text">
        <div class="text-left">
            <h3 style="font-size: 2.5rem;">Technical Direction and Project Management</h3>
        </div>
        <div class="text-right">
            <p class="sqsrte-large">Bachelor of Arts in Environmental Studies - Fordham University 2027</p>
            <p>Theater minor.</p>
            <p class="sqsrte-large">NYS Regents Diploma - Garden City High School 2023</p>
            <p>Recipient of many awards.</p>
        </div>
    </div>
</section>

<!-- PROJECTS CAROUSEL SECTION -->
<section class="page-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Featured Projects</h2>
            <p class="section-subtitle">Click arrows to explore my work</p>
        </div>

        <div class="carousel-container">
            <button class="carousel-arrow prev" aria-label="Previous project">❮</button>
            
            <div class="carousel-track-container">
                <div class="carousel-track">
                    {% for project in projectManagementProjects %}
                    <div class="carousel-slide">
                        <div class="project-card-carousel">
                            <div class="project-image-wrapper-carousel">
                                <img src="{{ project.image }}" alt="{{ project.title }}">
                                <div class="project-category-badge-carousel">{{ project.category }}</div>
                            </div>
                            <div class="project-info-carousel">
                                <h3 class="project-title-carousel">{{ project.title }}</h3>
                                <p class="project-role-carousel">{{ project.role }}</p>
                                <p class="project-year-carousel">{{ project.year }}</p>
                                <a href="{{ project.link }}" class="btn-carousel">View Details →</a>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <button class="carousel-arrow next" aria-label="Next project">❯</button>
        </div>

        <div class="carousel-dots">
            {% for project in projectManagementProjects %}
            <button class="dot" data-index="{{ loop.index0 }}"></button>
            {% endfor %}
        </div>
    </div>
</section>

<!-- FEATURE SECTION: Glimmerglass -->
<section class="page-section">
    <div class="feature-row">
        <div class="feature-text">
            <p class="sqsrte-large">Assistant Technical Director of Stage Operations</p>
            <p>The Glimmerglass Festival Full Season 2024</p>
            <p class="sqsrte-large" style="margin-top: 1.5rem;">Assistant Stage Operations Manager</p>
            <p>The Glimmerglass Festival Full Season 2023</p>
            <p style="margin-top: 1rem;">Joined the Glimmerglass family in 2023 as an Assistant Stage Operations Manager, ran scenery deck during Opera performances and assigned deck tracks to Stage Operations staff and apprentices. Led scenic changeovers, and scenery and prop transfers between three venues.</p>
            <p>In 2024 moved to be the Assistant Technical Director of Stage Operations, interviewed and hired 12-person department. Led, managed, and scheduled two assistant managers, five stage operations staff, and four apprentices for show running, repertory changeovers, and scenery and prop transfers.</p>
        </div>
        <div class="feature-image">
            <img src="https://images.squarespace-cdn.com/content/v1/66a135183ddfaa43af16a576/2bcee5ff-fad1-432c-a4cc-416b6e52c3b9/CAN2.jpg" alt="Glimmerglass Production">
        </div>
    </div>
</section>

<!-- FEATURE SECTION: Project Management -->
<section class="page-section">
    <div class="feature-row reverse">
        <div class="feature-text">
            <p class="sqsrte-large">Project Manager</p>
            <p>Carnegie Mellon University 2023-2025</p>
            <p style="margin-top: 1rem;">Manage CMU School of Drama's Technical Direction department for a period of 12 weeks for CMU's thirteen show season in three venues.</p>
            <p>Supervise and delegate responsibilities for all technical direction students' production assignments including: budgeting, drafting, building, installing, and striking each show.</p>
            <p>Create/maintain all schedules, build calendars, project tracking documents/databases.</p>
        </div>
        <div class="feature-image">
            <img src="https://images.squarespace-cdn.com/content/v1/66a135183ddfaa43af16a576/19b69576-c8d1-49ee-b675-4a3dba77efca/mom.jpg" alt="Project Management">
        </div>
    </div>
</section>

<!-- FEATURE SECTION: Drafting -->
<section class="page-section">
    <div class="feature-row">
        <div class="feature-text">
            <p class="sqsrte-large">Drafting - Technical Drawings & Paperwork</p>
            <p>2D and 3D technical drawings created in Blender</p>
            <p>Scenic Carpentry Projects</p>
            <p>Installation drawings</p>
            <p>Stage Management Papers</p>
            <p>3d Printing</p>
        </div>
        <div class="feature-image">
            <img src="https://images.squarespace-cdn.com/content/v1/66a135183ddfaa43af16a576/a4687ce0-8326-4c8d-a194-8fa2de23a919/P1+STEEL+STRUCTURE.jpeg" alt="Technical Drawing">
        </div>
    </div>
</section>

<!-- RECENTLY / RESUME SECTION -->
<section class="page-section">
    <div class="container">
        <hr>
        <h2 style="margin-bottom: 2rem;">Recently:</h2>
        <div class="recent-grid">
            {% for item in recent %}
            <div class="recent-item">
                <p>{{ item.year }} {{ item.location }}</p>
                <h4>{{ item.institution }}</h4>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
