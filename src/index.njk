---
layout: base.njk
title: Home
---

<!-- PROJECT SHOWCASE VIDEO - TOP OF PAGE -->
<section class="page-section">
    <div class="container">
        <div class="video-container">
            <video class="showcase-video" autoplay muted loop playsinline>
                <source src="/images/EventageVideo.mp4" type="video/mp4">
                Your browser does not support the video tag.
            </video>
        </div>
    </div>
</section>

<!-- INTRO TEXT SECTION -->
<section class="page-section">
    <div class="two-column-text">
        <div class="text-left">
            <h3 style="font-size: 2.5rem;">Technical Direction and Project Management</h3>
        </div>
        <div class="text-right">
            <p class="sqsrte-large">Bachelor of Arts in Environmental Studies - Fordham University 2027</p>
            <p>Theater minor.</p>
            <p class="sqsrte-large">NYS Regents Diploma - Garden City High School 2023</p>
            <p>Recipient of many awards.</p>
        </div>
    </div>
</section>

<!-- PROJECTS CAROUSEL SECTION -->
<section class="page-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Featured Projects</h2>
            <p class="section-subtitle">Click arrows to explore my work</p>
        </div>

        <div class="carousel-container">
            <button class="carousel-arrow prev" aria-label="Previous project">❮</button>
            
            <div class="carousel-track-container">
                <div class="carousel-track">
                    {% for project in projectManagementProjects %}
                    <div class="carousel-slide">
                        <div class="project-card-carousel">
                            <div class="project-image-wrapper-carousel">
                                <img src="{{ project.image }}" alt="{{ project.title }}">
                                <div class="project-category-badge-carousel">{{ project.category }}</div>
                            </div>
                            <div class="project-info-carousel">
                                <h3 class="project-title-carousel">{{ project.title }}</h3>
                                <p class="project-role-carousel">{{ project.role }}</p>
                                <p class="project-year-carousel">{{ project.year }}</p>
                                <a href="{{ project.link }}" class="btn-carousel">View Details →</a>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <button class="carousel-arrow next" aria-label="Next project">❯</button>
        </div>

        <div class="carousel-dots">
            {% for project in projectManagementProjects %}
            <button class="dot" data-index="{{ loop.index0 }}"></button>
            {% endfor %}
        </div>
    </div>
</section>

