<style>
/* Recently Section */
.recent-header {
    text-align: center;
    margin-bottom: 2rem;
}

.recent-title {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: #ffffff;
}

.recent-grid-layout {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1200px;
    margin: 2rem auto;
    padding: 0 2rem;
}

.recent-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.recent-item {
    margin-bottom: 0.5rem;
}

.recent-year {
    font-size: 0.9rem;
    color: #aaaaaa;
    margin-bottom: 0.25rem;
}

.recent-institution {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    color: #ffffff;
}

.recent-role {
    font-size: 0.85rem;
    color: #888888;
    line-height: 1.4;
}

hr {
    margin: 2rem 0;
    border: 0;
    height: 1px;
    background: #333333;
}

/* Responsive */
@media (max-width: 900px) {
    .recent-grid-layout {
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
        padding: 0 1.5rem;
    }
}

@media (max-width: 600px) {
    .recent-grid-layout {
        grid-template-columns: 1fr;
        gap: 1.5rem;
        padding: 0 1rem;
    }
    
    .recent-year {
        font-size: 0.8rem;
    }
    
    .recent-institution {
        font-size: 1rem;
    }
    
    .recent-role {
        font-size: 0.8rem;
    }
}
</style><!-- ============================================ -->

