---
layout: base.njk
title: Experience
---

<section class="page-section">
    <div class="container">
        <div class="experience-header">
            <h2 class="experience-title">Experience</h2>
            <p class="experience-subtitle">Project Management | Technical Direction | Fabrication | Drafting | Miscellaneous</p>
        </div>
        
        <!-- Dropdown Filter -->
        <div class="filter-container">
            <label for="category-select" class="filter-label">Filter by category:</label>
            <select id="category-select" class="category-select">
                <option value="all">All Experience</option>
                <option value="Project Management">Project Management</option>
                <option value="Technical Direction">Technical Direction</option>
                <option value="Fabrication">Fabrication</option>
                <option value="Drafting">Drafting</option>
                <option value="Miscellaneous">Miscellaneous</option>
            </select>
        </div>
        
        <div class="experience-grid" id="experienceGrid">
            {% for project in allProjects %}
            <div class="experience-card" data-category="{{ project.category }}">
                <a href="{{ project.link }}" class="experience-card-link">
                    <div class="experience-image-wrapper">
                        <img src="{{ project.image }}" alt="{{ project.title }}" loading="lazy">
                        <div class="experience-category-badge">{{ project.category }}</div>
                    </div>
                    <div class="experience-info">
                        <h3 class="experience-title-card">{{ project.title }}</h3>
                        <p class="experience-role">{{ project.role }}</p>
                        <p class="experience-year">{{ project.year }}</p>
                    </div>
                    <div class="experience-button-wrapper">
                        <span class="experience-button">View Details →</span>
                    </div>
                </a>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<style>
    .experience-header {
        text-align: center;
        margin-bottom: 2rem;
        padding: 2rem 0 1rem;
    }

    .experience-title {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 600;
        margin-bottom: 0.5rem;
        letter-spacing: -0.02em;
        color: #ffffff;
    }

    .experience-subtitle {
        font-size: 1.2rem;
        color: #aaaaaa;
        font-weight: 400;
    }

    /* Dropdown Filter */
    .filter-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2.5rem;
        flex-wrap: wrap;
    }

    .filter-label {
        color: #ffffff;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .category-select {
        background: #111111;
        color: #ffffff;
        border: 1.5px solid #444444;
        border-radius: 30px;
        padding: 0.5rem 1.5rem;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        font-family: inherit;
    }

    .category-select:hover {
        border-color: #ffffff;
    }

    .category-select:focus {
        outline: none;
        border-color: #ffffff;
    }

    /* Experience Grid */
    .experience-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2rem;
        max-width: 1400px;
        margin: 0 auto;
        padding: 1rem 0 3rem;
    }

    .experience-card {
        background: #111111;
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    .experience-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    }

    .experience-card-link {
        text-decoration: none;
        display: block;
    }

    .experience-image-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: #222222;
    }

    .experience-image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center center;
        display: block;
        transition: transform 0.3s ease;
    }

    .experience-card:hover .experience-image-wrapper img {
        transform: scale(1.03);
    }

    .experience-category-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: rgba(255,255,255,0.95);
        color: #000000;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .experience-info {
        padding: 1.25rem 1.25rem 0.5rem;
    }

    .experience-title-card {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 0.35rem;
        color: #ffffff;
    }

    .experience-role {
        font-size: 0.85rem;
        color: #cccccc;
        margin-bottom: 0.25rem;
    }

    .experience-year {
        font-size: 0.8rem;
        color: #888888;
    }

    .experience-button-wrapper {
        padding: 0 1.25rem 1.25rem;
        text-align: left;
    }

    .experience-button {
        display: inline-block;
        color: #ffffff;
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .experience-card:hover .experience-button {
        color: #0066cc;
        transform: translateX(3px);
    }

    /* Responsive */
    @media (max-width: 768px) {
        .experience-grid {
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
            padding: 0 1rem 2rem;
        }
        
        .filter-container {
            margin-bottom: 1.5rem;
            padding: 0 1rem;
        }
        
        .experience-info {
            padding: 1rem 1rem 0.25rem;
        }
        
        .experience-button-wrapper {
            padding: 0 1rem 1rem;
        }
    }

    @media (max-width: 480px) {
        .experience-grid {
            grid-template-columns: 1fr;
        }
        
        .filter-container {
            flex-direction: column;
            gap: 0.5rem;
        }
    }
</style>

<script>
    // Dropdown filter functionality
    document.addEventListener('DOMContentLoaded', function() {
        const categorySelect = document.getElementById('category-select');
        const experienceCards = document.querySelectorAll('.experience-card');
        
        function filterProjects() {
            const selectedCategory = categorySelect.value;
            
            experienceCards.forEach(card => {
                const cardCategory = card.getAttribute('data-category');
                
                if (selectedCategory === 'all' || cardCategory === selectedCategory) {
                    card.style.display = 'block';
                    setTimeout(() => {
                        card.style.opacity = '1';
                        card.style.transform = 'scale(1)';
                    }, 10);
                } else {
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.8)';
                    setTimeout(() => {
                        card.style.display = 'none';
                    }, 200);
                }
            });
        }
        
        categorySelect.addEventListener('change', filterProjects);
    });
</script>
